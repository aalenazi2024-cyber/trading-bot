# Alpaca API Credentials
# Get yours at https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "paper" for paper trading, "live" for real money
TRADING_MODE=paper

# Base URL (paper trading by default)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Max position size in dollars (per trade)
MAX_POSITION_SIZE=5000

# Max daily loss before bot stops (dollars)
MAX_DAILY_LOSS=2000

# Max number of simultaneous positions
MAX_OPEN_POSITIONS=3
