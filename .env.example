# ============================================================
# BROKER SELECTION: "ibkr" (default) or "alpaca"
# ============================================================
BROKER=ibkr

# ============================================================
# IBKR (Interactive Brokers) - DEFAULT BROKER
# Requires TWS or IB Gateway running with API enabled
# ============================================================
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
# Port 7497 = Paper Trading (TWS)
# Port 7496 = Live Trading (TWS)
# Port 4002 = Paper Trading (IB Gateway)
# Port 4001 = Live Trading (IB Gateway)
IBKR_CLIENT_ID=1
IBKR_TRADING_MODE=paper

# ============================================================
# ALPACA (Alternative broker)
# Get keys at https://app.alpaca.markets/
# ============================================================
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
TRADING_MODE=paper

# ============================================================
# TRADINGVIEW WEBHOOK
# Receives alerts from TradingView indicators/strategies
# ============================================================
TRADINGVIEW_ENABLED=false
TRADINGVIEW_HOST=0.0.0.0
TRADINGVIEW_PORT=5000
# Generate a random token: python -c "import secrets; print(secrets.token_hex(16))"
TRADINGVIEW_TOKEN=your_secret_token_here

# ============================================================
# RISK SETTINGS — ALL-IN COMPOUNDING MODE
# ============================================================
# Use 95% of account equity per trade (all-in)
ACCOUNT_EQUITY_PCT=95
# Set to 0 to use ACCOUNT_EQUITY_PCT instead of a fixed dollar amount
MAX_POSITION_SIZE=0
# Max daily loss — set high since we're going all-in
MAX_DAILY_LOSS=50000
# Only 1 position at a time (all-in mode)
MAX_OPEN_POSITIONS=1
# Profit target per trade (30-50% range, 40% default)
PROFIT_TARGET_PCT=40
# Stop loss per trade
STOP_LOSS_PCT=40
# Account goal
ACCOUNT_GOAL=200000000
